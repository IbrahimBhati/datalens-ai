# ==============================================================================
# DataLens AI — Monorepo Production Environment Template (.env.example)
# ==============================================================================
# Copy this file to create your environment variables, or configure them
# in your cloud deployment dashboards (Render for backend, Vercel for frontend).

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Configure in Vercel Dashboard)
# ------------------------------------------------------------------------------
# Deployed URL of your backend (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Configure in Render Dashboard)
# ------------------------------------------------------------------------------
# Port is automatically assigned by Render ($PORT)
PORT=8000
HOST=0.0.0.0

# CORS Origins (Include your Vercel frontend URL, comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
CORS_ORIGIN_REGEX=^https?:\/\/(localhost|127\.0\.0\.1)(:\d+)?$|^https:\/\/.*\.vercel\.app$

# AI Engine (Optional - deterministic fallback activates if blank)
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=25.0

# Privacy & Governance
DATASET_RETENTION_HOURS=24
RATE_LIMIT_REQUESTS_PER_MINUTE=120
