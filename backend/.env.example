# ==============================================================================
# DataLens AI — Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Network Binding (Render sets PORT automatically)
PORT=8000
HOST=0.0.0.0

# CORS Whitelist (comma-separated origins)
# For production, add your deployed frontend URL (e.g. https://datalens-ai.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CORS Origin Regex (allows all Vercel deployment preview URLs)
CORS_ORIGIN_REGEX=^https?:\/\/(localhost|127\.0\.0\.1)(:\d+)?$|^https:\/\/.*\.vercel\.app$

# Upload Constraints & Storage
MAX_UPLOAD_SIZE=52428800
# Optional: custom upload directory (defaults to system tempdir on cloud/containers)
# UPLOAD_DIR=/tmp/datalens_uploads

# AI / LLM Configuration (Optional — fallback engine operates without key)
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=25.0

# Security & Data Lifecycle Policies
DATASET_RETENTION_HOURS=24
RATE_LIMIT_REQUESTS_PER_MINUTE=120
